#!/bin/sh
[ "${ALLOW_MODEL:-}" = "1" ] && exit 0
[ -x node_modules/.bin/likec4 ] || exit 0
[ -d "${ARCHITECTURE_DIR:-docs/architecture}" ] || exit 0

# Validate the architecture model: syntax, references, and layout drift.
found=$(mktemp -t nvmodel)
node_modules/.bin/likec4 validate "${ARCHITECTURE_DIR:-docs/architecture}" >"$found" 2>&1
status=$?
if [ "$status" -ne 0 ]; then
  echo "pre-push: the architecture model does not validate." >&2
  grep -v 'INFO' "$found" >&2
  rm -f "$found"
  echo "pre-push: fix it, or override: ALLOW_MODEL=1 git push" >&2
  exit 1
fi
rm -f "$found"
exit 0
