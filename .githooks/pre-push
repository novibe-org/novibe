#!/bin/sh
# What this repository runs. The guards themselves are in conventions/, and stand alone.
here=$(cd "$(dirname "$0")/../conventions" && pwd)
"$here/git/pre-push"     "$@" || exit 1
"$here/code/pre-push"    "$@" || exit 1
"$here/gherkin/pre-push" "$@" || exit 1
"$here/likec4/pre-push"  "$@" || exit 1
exit 0
