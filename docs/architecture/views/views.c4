views {

  view context {
    title 'Context'
    include novibe, driver, github
    autoLayout LeftRight
  }

  view novibe of novibe {
    title 'Level 1: NoVibe'
    include *, driver, github
    autoLayout LeftRight
  }

  view portal of novibe.portal {
    title 'Level 2: portal'
    include *, driver, github
    autoLayout LeftRight
  }

  dynamic view readFeatures {
    title 'Runtime: the driver reads the features on a branch'
    driver -> novibe.portal.app 'opens the portal, on main or the branch in its address'
    novibe.portal.app -> novibe.portal.worker 'the branches, and every feature of that branch with its results and the plan'
    novibe.portal.worker -> github 'the branches'
    novibe.portal.worker -> github 'the feature files on that branch'
    novibe.portal.worker -> github 'that branch\'s latest finished test run, with its results'
    novibe.portal.worker -> novibe.portal.plan 'this repository\'s epics'
    novibe.portal.worker -> novibe.portal.app 'the branches · each feature parsed, with its results · the epics, a feature not on the branch marked'
    novibe.portal.app -> driver 'the branches to choose from, the epics with their features, then the rest · or: none yet'
    driver -> novibe.portal.app 'reads one'
    novibe.portal.app -> driver 'the feature as written'
    autoLayout TopBottom
  }

  dynamic view changePlan {
    title 'Runtime: the driver changes the plan'
    driver -> novibe.portal.app 'changes the plan'
    novibe.portal.app -> novibe.portal.worker 'that one change'
    novibe.portal.worker -> novibe.portal.plan 'applies it'
    novibe.portal.worker -> novibe.portal.app 'the plan as changed · or: refused, and why'
    novibe.portal.app -> driver 'the plan as changed'
    autoLayout TopBottom
  }

  deployment view local {
    title 'Deployment: on the driver\'s machine'
    include machine.**, githubCom.**
    autoLayout LeftRight
  }
}
